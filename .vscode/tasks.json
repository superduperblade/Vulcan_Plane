{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build"],
      "dependsOn": "cmake: configure",
      "group": { "kind": "build", "default": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cmake: build windowed",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build-windowed", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug", "-DBUILD_WINDOWED=ON"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run: vp_core (headless)",
      "type": "shell",
      "command": "${workspaceFolder}/build/vp_core",
      "dependsOn": "cmake: build",
      "problemMatcher": []
    }
  ]
}
